# Konfigurace aplikace Sklad Dřevěnka s.r.o.
PROJECT_NAME="Sklad Dřevěnka s.r.o."
APP_ENV=development
DEBUG=True

# Databáze PostgreSQL (běžící v Dockeru)
DATABASE_URL=postgresql+psycopg://drevenka:drevenka_secret@db:5432/drevenka_db

# Port aplikace
PORT=8000

# Nastavení autentizace a demo účtů (vývojové syntetické hodnoty)
SESSION_COOKIE_NAME=drevenka_session
SESSION_TTL_HOURS=24
DEMO_MANAGER_PASSWORD=drevenka2026
DEMO_WAREHOUSE_PASSWORD=sklad2026
